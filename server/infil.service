# /etc/systemd/system/myapp.service

[Unit]
Description="i recv data from pico w and log them to sqlitedb"
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
RuntimeDirectory=infil
RuntimeDirectoryMode=0755
WorkingDirectory=/var/www/infil
ExecStart=/var/www/infil/server/build/src/pico-server
LogsDirectory=infil

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=pico infiltration system
After=network.target

