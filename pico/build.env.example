export ROOM_LOCATION="south entrance"   # position of pico in the room
export WIFI_SSID="wifi_ssid"            # accessible wifi name
export WIFI_PASSWORD="wifi_password"    # the wifi password
export SERVER_ADDRESS="192.168.100.10"  # remote ip
export SERVER_PORT=9090                 # remote port
export NLOGGING=0                       # no logging to tty
export UPDATE_TIME_S=3                  # duration for sending updates to server

